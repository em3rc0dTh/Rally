# Copy to .env.traccar (gitignored) and chmod 600. Only traccar-sync reads this file.
# Traccar API user token: generate it in Traccar after creating your account.
TRACCAR_TOKEN=
# New Rally role=connector source=traccar token from Tenant A's Access management.
# Do not reuse administrator or revoked/testing credentials.
RALLY_TENANT_TOKEN=
# JSON mapping from Traccar API *numeric* device id to Rally asset UUID.
# Example (replace with real IDs): {"31":"00000000-0000-4000-8000-000000000001"}
TRACCAR_DEVICE_ASSET_MAP={}
# Optional position freshness threshold in seconds.
TRACCAR_MAX_POSITION_AGE_SECONDS=300
