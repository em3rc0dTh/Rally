# One process + source-scoped credential per tenant/provider.
RALLY_CONNECTOR=odoo
RALLY_URL=https://rally.example.com
RALLY_TENANT_TOKEN=
RALLY_CONNECTOR_SECONDS=60
ODOO_URL=https://odoo.example.com
ODOO_DATABASE=
ODOO_INSTANCE=
ODOO_COMPANY_IDS=1
# REQUIRED: filter confirmed sales to an explicitly approved work-order subset.
# Example assumes you created this field in Odoo; do not use blindly.
ODOO_WORKORDER_DOMAIN_JSON='[["x_rally_work_order","=",true]]'
ODOO_API_KEY=
TRACCAR_URL=https://gps.example.com
TRACCAR_TOKEN=
TRACCAR_INSTANCE=
TRACCAR_DEVICE_ASSET_MAP={}
# A device position is fresh only when valid=true and fix age <= this threshold.
TRACCAR_MAX_POSITION_AGE_SECONDS=300
RFID_EPC_ASSET_MAP={}
RFID_SPOOL_PATH=./data/rfid-spool.db
RFID_MAX_SPOOL_EVENTS=100000

# SQLite disk budget for buffered RFID records (default 256 MiB)
RFID_MAX_SPOOL_BYTES=268435456
