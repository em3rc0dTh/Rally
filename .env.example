# REQUIRED: generate a new secret of 32+ random characters; an empty value blocks startup.
RALLY_ADMIN_KEY=
RALLY_ENV=development
RALLY_DB_PATH=./data/rally.db
# PostgreSQL is mandatory when RALLY_ENV=production.
RALLY_DATABASE_URL=
RALLY_ALLOWED_HOSTS=localhost,127.0.0.1
RALLY_RATE_PER_MINUTE=600
RALLY_RECONCILE_SECONDS=60
RALLY_WORKER_STALE_SECONDS=180
RALLY_CONNECTOR_STALE_SECONDS=300
