# Copy to .env.odoo-enterprise, chmod 600. NEVER commit the filled file.
# Get an Odoo 19 JSON-2 API key only from a user with approved least-privilege read access.
ODOO_URL=https://YOUR_ODOO_INSTANCE
ODOO_DATABASE=
ODOO_API_KEY=
# Stable namespace used in a dedicated Rally Odoo connector credential's scope.
ODOO_INSTANCE=
# Must match actual authorized Odoo company IDs and Rally model grants.
ODOO_COMPANY_IDS=
RALLY_TENANT_TOKEN=
# Explicitly opt in only to approved models (sample: purchase orders).
ODOO_ENTERPRISE_MODELS=purchase.order
# Mandatory nonempty per-model selectors; the example is not a complete real policy.
ODOO_ENTERPRISE_SELECTORS_JSON={"purchase.order":[["state","in",["purchase","done"]]]}
ODOO_ENTERPRISE_MAX_PER_MODEL=10000
